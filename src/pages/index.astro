---
import Base from '../layouts/Base.astro';

const title = 'Jason Daihl — Staff Frontend Engineer';
const description =
  'Staff Frontend Engineer specializing in UI platforms and design systems.';
---

<Base title={title} description={description}>
  <main>
    <header>
      <img
        src="https://www.gravatar.com/avatar/35379cebfed703bdf440b3776b939209?s=240"
        alt="Jason Daihl"
        class="avatar"
        width="120"
        height="120"
      />
      <div>
        <h1>Jason Daihl</h1>
        <p class="title" role="doc-subtitle">Staff Frontend Engineer</p>
        <p class="subtitle">UI Platforms & Design Systems</p>
      </div>
    </header>

    <section aria-label="About">
      <p class="statement">
        I specialize in design systems and UI platform infrastructure. My work
        sits at the intersection of design and engineering — building the
        component libraries, tooling, and token systems that help product teams
        move faster.
      </p>
    </section>

    <nav aria-label="Links">
      <ul class="link-list" role="list">
        <li>
          <a href="https://github.com/jasondaihl">
            <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.2 11.16.6.1.82-.25.82-.56v-2c-3.34.72-4.04-1.6-4.04-1.6-.55-1.37-1.33-1.74-1.33-1.74-1.09-.73.08-.72.08-.72 1.2.08 1.83 1.21 1.83 1.21 1.07 1.8 2.8 1.28 3.49.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.3-5.47-5.79 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.5.1-3.12 0 0 1.01-.32 3.3 1.2a11.6 11.6 0 0 1 6 0c2.29-1.52 3.3-1.2 3.3-1.2.64 1.62.24 2.82.11 3.12.77.82 1.23 1.87 1.23 3.15 0 4.5-2.8 5.48-5.48 5.77.43.37.82 1.1.82 2.22v3.29c0 .32.21.68.82.56A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/>
            </svg>
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a href="https://linkedin.com/in/jasondaihl">
            <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a href="mailto:jason@daihl.com">
            <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span>Email</span>
